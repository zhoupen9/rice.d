{
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "niri/workspaces": {
    "icon": true,
    "icon-size": 18,
    "format": "{icon}",
    "format-icons": {
      // Named workspaces
      // (you need to configure them in niri)
      "browser": "",
      "discord": "",
      "chat": "<b></b>",
      // Icons by state
      //"active": "",
      "active": "󱎴"
      //"default": ""
      //"default": "<span color=\"gray\">󰍹</span>"
    }
  },
  "niri/window": {
    "icon": true,
    "icon-size": 18,
    "swap-icon-label": false,
    "format": "{title}"
  }
}
